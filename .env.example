# Local Vite proxy destination. This value is used only by the development server.
API_PROXY_TARGET=http://localhost:3001

# Optional browser-facing URL baked into a production client build. Leave unset
# when the deployed frontend reverse-proxies /api to the service.
# VITE_COURSE_TREE_SEARCH_URL=https://api.example.com/treesearch/

# Standalone API configuration.
PORT=3001
CORS_ORIGIN=http://localhost:5173
